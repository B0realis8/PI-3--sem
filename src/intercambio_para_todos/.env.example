# ============================================================================
# INSTAGRAM WEBHOOK CONFIGURATION
# ============================================================================

# Custom token for webhook verification (you create this - random string)
# Used by Meta to verify your webhook endpoint
VERIFY_TOKEN="your_custom_verify_token_here"

# Your Facebook App Secret
# Get from: Facebook Developers > Your App > Settings > Basic
APP_SECRET=your_facebook_app_secret_here

# Page Access Token
# Get from: Facebook Graph API Explorer > Select your app > Get User Access Token
# Then query: me/accounts to get your page token
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Instagram Business Account ID
# Get from: Graph API query on page: {PAGE_ID}?fields=instagram_business_account
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Facebook Page ID
# Get from: Your Facebook Page > Page Info or Graph API Explorer
PAGE_ID=your_facebook_page_id_here

# OpenAI API Key for AI product matching
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_URI=postgresql://username:password@localhost:5432/database_name
DW_RUI=postgresql://username:password@localhost:5432/dw_database_name

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. RENAME THIS FILE TO .env (remove .example)
# 2. FILL IN ALL VALUES BELOW
#
# HOW TO GET EACH TOKEN:
#
# VERIFY_TOKEN:
#   - Create any random string (min 8 chars)
#   - Example: "abc123def456xyz789"
#   - Use this when setting up webhook in Facebook
#
# APP_SECRET:
#   - Go to: https://developers.facebook.com/
#   - Click: My Apps > Your App
#   - Go to: Settings > Basic
#   - Copy: App Secret (show it first)
#
# PAGE_ACCESS_TOKEN:
#   - Go to: https://developers.facebook.com/tools/explorer
#   - Select your App from dropdown
#   - Click: Generate Access Token
#   - Select: pages_read_engagement, pages_manage_metadata, instagram_basic
#   - In query field: me/accounts
#   - Execute and copy access_token from response
#   - Note: This token expires periodically. For production, get a Long-Lived Token
#
# INSTAGRAM_BUSINESS_ACCOUNT_ID:
#   - Get your PAGE_ID first
#   - In Graph API Explorer query: {PAGE_ID}?fields=instagram_business_account
#   - Execute and copy the id from instagram_business_account object
#
# OPENAI_API_KEY:
#   - Go to: https://platform.openai.com/account/api-keys
#   - Click: Create new secret key
#   - Copy it (you won't see it again!)
#
# ============================================================================
